{
  "name": "vkodex",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source VK bot for remote control of OpenAI Codex. Бот для удалённого управления Codex через ВКонтакте.",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/assert-production-build.mjs",
    "start": "node --env-file=.env dist/src/index.js",
    "runtime:prepare": "node --import tsx src/desktop/launch.ts prepare",
    "desktop:probe": "node --import tsx src/desktop/launch.ts probe",
    "desktop:dev": "npm run build && node --import tsx src/desktop/launch.ts dev",
    "desktop:start": "node dist/src/desktop/launch.js start",
    "profile-server:launch": "node dist/src/profile-server-main.js",
    "vk:check": "node --import tsx src/desktop/launch.ts check",
    "vk:token:setup": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/setup-vk-document-token.ps1",
    "vk:token:import": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/import-vk-document-token.ps1",
    "health:check": "node --env-file=.env --import tsx src/desktop/health-check.ts",
    "diagnostics:read": "node dist/src/diagnostics-main.js",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-task.ps1",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-windows-task.ps1",
    "service:controlled-restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/controlled-restart.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test --test-concurrency=4 test/*.test.ts",
    "integration:test": "node --import tsx --test --test-concurrency=1 test/integration/production-pinned-first-thread.test.ts",
    "check": "npm run typecheck && npm test && npm run integration:test"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.155.1",
    "better-sqlite3": "13.0.3",
    "pino": "10.3.1",
    "vk-io": "4.10.1",
    "ws": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
