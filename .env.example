# VK community
VK_GROUP_TOKEN=
# Optional path to the DPAPI-protected user token used only to delete old VKodex documents.
# Create it locally with: npm run vk:token:setup
# VK_DOCUMENT_TOKEN_PATH=C:\\path\\to\\vk-document-token.xml
VK_GROUP_ID=

# Experimental desktop bridge only (npm run desktop:dev): one private owner ID.
# Never commit a filled-in value. The legacy SDK bot below uses separate *_IDS settings.
VK_OWNER_ID=
# Empty means the current user's .codex directory. Desktop data is opened read-only.
CODEX_HOME=
# Additional Codex data directories, as a JSON array. Primary CODEX_HOME stays included.
# Use forward slashes on Windows; ~ expands to the current user's home directory.
# Example: CODEX_EXTRA_HOMES='["~/.codex-work", "D:/CodexProfiles/another"]'
CODEX_EXTRA_HOMES=[]
# Preferred multi-profile configuration. When non-empty, this replaces CODEX_HOME
# and CODEX_EXTRA_HOMES. Keep account-specific paths only in the ignored .env.
# owner=app-server keeps one long-lived Codex owner per profile. A task already
# held by Desktop/VS Code is routed to that connected client before mutation.
# The launcher is used only by the explicit /open action.
# Example: CODEX_SOURCES='[{"home":"~/.codex","owner":"app-server","launcher":{"type":"desktop"}},{"home":"~/.codex-work","owner":"app-server","launcher":{"type":"vscode","executable":"C:/Path/To/Code.exe","userDataDir":"C:/Path/To/Code-Codex-Work"}}]'
CODEX_SOURCES=
# Optional root for automatically created projectless task folders.
# Empty uses the current user's local application-data directory.
VKODEX_PROJECTLESS_ROOT=

# Numeric VK user IDs. Owners can bootstrap the main chat and create sessions.
VK_OWNER_IDS=
VK_ALLOWED_USER_IDS=

# Users invited to the dedicated main chat by /bootstrap.
# Empty means VK_OWNER_IDS.
VK_MAIN_USER_IDS=

# Optional existing control conversation peer_id.
# A chat peer_id is usually 2000000000 + chat_id.
VK_MAIN_PEER_ID=

# managed: every session must get a real VK chat
# single: all sessions are selected and used in the main chat
# auto: try a real chat, then fall back to the main chat
VK_CONVERSATION_MODE=auto

# requester: invite only the creator to a session chat
# main-users: invite all VK_MAIN_USER_IDS
VK_SESSION_MEMBER_MODE=requester

# Comma-separated existing directories; use absolute paths for local runs.
# Relative /new paths are searched inside these roots.
WORKSPACE_ROOTS=/workspaces

# SQLite database directory.
BOT_DATA_DIR=./data

# Legacy SDK mode. The bridge passes OPENAI_API_KEY through the SDK's apiKey option;
# VK_GROUP_TOKEN and the rest of the bot environment are not inherited by Codex.
OPENAI_API_KEY=
CODEX_MODEL=
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never
CODEX_SKIP_GIT_REPO_CHECK=false

# Extra process environment names that Codex commands are explicitly allowed
# to inherit, for example SSH_AUTH_SOCK or a private-registry token.
# Values named here may be visible to code/commands executed by Codex.
CODEX_ENV_ALLOWLIST=

# Attachments
MAX_INBOUND_FILES=10
MAX_INBOUND_FILE_BYTES=209715200
MAX_INBOUND_TOTAL_BYTES=209715200
MAX_OUTBOUND_FILES=10
MAX_OUTBOUND_FILE_BYTES=26214400
MAX_OUTBOUND_TOTAL_BYTES=52428800
DOWNLOAD_TIMEOUT_MS=600000

# VK text is split conservatively even though some API methods accept more.
VK_MESSAGE_CHUNK_SIZE=3500
LOG_LEVEL=info

# Full operational health check: VK, delivery queue, SQLite, Codex catalogs,
# named pipe / stream protocol and active task subscriptions. 30s minimum.
HEALTH_CHECK_INTERVAL_MS=60000
